# Copy to .env and fill in.

# Chat model: openai | gemini | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Retries when the model is busy or rate-limited
LLM_MAX_RETRIES=4
# Speed: longest reply in tokens, request timeout in seconds,
# and Gemini 3 thinking level (low = fastest; "default" leaves it to the model)
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_THINKING_LEVEL=low
OPENAI_API_KEY=
# For LLM_PROVIDER=gemini (free key at aistudio.google.com), set LLM_MODEL
# to a Gemini model, e.g. gemini-3.8-flash, and uncomment:
# GOOGLE_API_KEY=

# Embeddings: huggingface (local, free) | openai | gemini | hash (offline demo only)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store: chroma (persistent) | memory (in-process)
VECTOR_BACKEND=chroma
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=user_memories

# Recall tuning
RECALL_TOP_K=5
RECALL_MIN_SCORE=0.25
DUPLICATE_THRESHOLD=0.92

# Short-term memory: recent messages kept verbatim before older ones are summarised
KEEP_RECENT_MESSAGES=8

LOG_DB_PATH=data/interactions.sqlite
